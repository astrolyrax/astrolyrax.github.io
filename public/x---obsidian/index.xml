k&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;     {  &#xA;       &amp;#34;firstName&amp;#34;: &amp;#34;John&amp;#34;,  &#xA;       &amp;#34;lastName&amp;#34;: &amp;#34;Smith&amp;#34;,  &#xA;       &amp;#34;age&amp;#34;: 25  &#xA;     }  &lt;/code&gt;&lt;/pre&gt;&lt;h2 id=&#34;7-horizontale-linie&#34;&gt;7. Horizontale Linie&lt;a class=&#34;anchor&#34; href=&#34;#7-horizontale-linie&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;p&gt;   &amp;mdash;&lt;/p&gt;</description>
